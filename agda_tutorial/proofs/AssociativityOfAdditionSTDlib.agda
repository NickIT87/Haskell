module AssociativityOfAdditionSTDlib where

-- Импортируем натуральные числа ℕ, их конструкторы:
--   zero — число 0;
--   suc n — число, следующее за n (то есть n + 1),
-- а также операцию сложения _+_.
-- В стандартном определении сложение задаётся рекурсией по первому
-- аргументу: zero + n = n, suc m + n = suc (m + n).
open import Data.Nat using (ℕ; zero; suc; _+_)

-- Импортируем равенство _≡_ и его доказательные комбинаторы:
--   refl  — равенство выражения самому себе после вычисления;
--   cong  — сохранение равенства при применении одной и той же функции;
--   sym   — обращение направления равенства;
--   trans — транзитивность равенства.
open import Relation.Binary.PropositionalEquality
  using (_≡_; refl; cong; sym; trans)

-- Формулировка задачи — ассоциативность сложения натуральных чисел:
-- для любых a, b и c результат не зависит от расстановки скобок:
--   (a + b) + c = a + (b + c).
--
-- В Agda тип «(a + b) + c ≡ a + (b + c)» — это не просто утверждение,
-- а тип, значением которого должно быть доказательство данного равенства.
-- Стрелки связывают аргументы слева направо: функция принимает три
-- натуральных числа и возвращает доказательство равенства.
+-assoc : (a b c : ℕ)
        → (a + b) + c ≡ a + (b + c)

-- Доказываем утверждение индукцией по a. Это естественный выбор, потому
-- что сложение из Data.Nat раскрывается по первому аргументу.
--
-- База индукции: a = 0.
--   (0 + b) + c = b + c
--   0 + (b + c) = b + c.
-- После вычисления обе стороны буквально совпадают, поэтому достаточно
-- конструктора refl — равенство выражения самому себе.
+-assoc zero b c = refl

-- Переход индукции: предположим, что равенство верно для a, и докажем
-- его для suc a:
--   (suc a + b) + c ≡ suc a + (b + c).
--
-- Раскрываем определение сложения по первому аргументу:
--   suc ((a + b) + c) ≡ suc (a + (b + c)).
-- По предположению индукции уже есть доказательство
--   +-assoc a b c : (a + b) + c ≡ a + (b + c).
-- Функция suc сохраняет равенство: cong suc применяет suc к обеим
-- сторонам этого равенства и тем самым доказывает требуемый переход.
+-assoc (suc a) b c = cong suc (+-assoc a b c)

-- □ ← здесь доказательство закончено 