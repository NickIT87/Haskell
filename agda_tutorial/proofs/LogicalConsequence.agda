-- Пример 2. Логическое следствие: из P и Q следует P
-- Это одна из базовых теорем логики.
-- P and Q -> P

module LogicalConsequence where

-- Импортируем тип зависимой пары Σ и её конструктор _,_.
-- Конструктор собирает пару, например (a , b).
open import Agda.Builtin.Sigma using (Σ; _,_)

-- Объявляем × инфиксным оператором с приоритетом 4 и правой
-- ассоциативностью, чтобы записи вроде A × B × C разбирались справа налево.
infixr 4 _×_

-- В логике A × B соответствует утверждению «A и B».
-- В Agda тип Σ A (λ _ → B) описывает пару: первый элемент имеет тип A,
-- а второй — тип B, не зависящий от значения первого элемента.
_×_ : Set → Set → Set
A × B = Σ A (λ _ → B)

-- Тип функции выражает логическое следствие:
-- если дано доказательство A × B, то можно получить доказательство A.
-- A и B здесь неявные параметры: Agda выводит их из типа аргумента.
fst : {A B : Set} → A × B → A
-- Пара (a , b) содержит доказательства a : A и b : B.
-- Возвращаем a, то есть первое доказательство, и тем самым доказываем A.
-- Второе доказательство b для этого вывода не требуется.
fst (a , b) = a

-- □ ← здесь доказательство закончено 

